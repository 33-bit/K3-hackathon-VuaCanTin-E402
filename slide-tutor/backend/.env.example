APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_PORT=6333
DATABASE_URL=postgresql+asyncpg://slide_tutor:slide_tutor@postgres:5432/slide_tutor
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=replace-with-a-long-random-value
QDRANT_COLLECTION_ALIAS=slide_chunks
QDRANT_PHYSICAL_COLLECTION=slide_chunks_te3large_1536_bm25_v1
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-4o-2024-08-06
OPENAI_FAST_MODEL=gpt-4o-mini-2024-07-18
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536
RERANK_MIN_RELEVANCE=0.35
CONTEXT_TOKEN_BUDGET=10000
EMBEDDING_VERSION=te3large_1536_v1
RETRIEVAL_SCHEMA_VERSION=qdrant_bm25_rrf_v1
UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=52428800
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_COURSE_ID=00000000-0000-0000-0000-000000000010
AUTH_PROXY_SHARED_SECRET=
WORKER_LOCK_TIMEOUT_SECONDS=1800
QUERY_UNDERSTANDING_CACHE_TTL_SECONDS=3600
RECONCILE_INTERVAL_SECONDS=900
OLD_VECTOR_RETENTION_SECONDS=3600
